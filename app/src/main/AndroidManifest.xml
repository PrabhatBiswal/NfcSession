<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Not required, so the app still installs on a phone without NFC and says so. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <application android:label="NFC Session Demo" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
